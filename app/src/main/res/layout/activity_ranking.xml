<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#660000">


    <!-- Título -->

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="744dp"
        android:text="Voltar"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.474"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RANKING DE HOJE:"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card com os 3 primeiros colocados -->
    <LinearLayout
        android:id="@+id/llTopRanking"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="55dp"
        android:background="#660000"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <!-- Segundo lugar -->

        <!-- Primeiro lugar -->

        <!-- Terceiro lugar -->
        <LinearLayout
            android:layout_width="18dp"
            android:layout_height="160dp"
            android:layout_weight="1"
            android:background="#E1B213"
            android:orientation="vertical">

            <TextView
                android:id="@+id/top2Name"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="Francisco"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/top2Score"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:text="570 Pontos"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="22dp"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:background="#1A472A"
            android:orientation="vertical">

            <TextView
                android:id="@+id/top1Name"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:text="Catarina"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:text="1"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/top1Score"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="490 Pontos"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="17dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:background="#222F5B"
            android:orientation="vertical">

            <TextView
                android:id="@+id/top3Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lin Tse Min"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/top3Score"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:text="450 Pontos"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layout para o RecyclerView -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="351dp"
        android:layout_height="469dp"
        android:background="#CECCCC"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llTopRanking"
        app:layout_constraintVertical_bias="0.0">

        <!-- RecyclerView para o ranking -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ranking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:clipToPadding="false"
            android:padding="8dp"
            android:scrollbars="vertical" />



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>